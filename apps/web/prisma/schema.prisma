// Twirl data model. Decisions and conventions: docs/adr/0007-data-model.md.
// After editing: `pnpm --filter @twirl/web db:migrate --name <change>` (local database).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth.js (Prisma adapter) ──────────────────────────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── Workspaces ───────────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  STARTER
  PRO
}

/// Only OWNER is used in v1; the table is ready for teams.
enum Role {
  OWNER
  MEMBER
}

/// The tenant. Every merchant-owned row hangs off a workspace.
model Workspace {
  id            String         @id @default(cuid())
  name          String
  plan          Plan           @default(FREE)
  /// Set when an admin changes the plan by hand (no billing in v1).
  planSetById   String?
  planSetAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  products      Product[]
  assets        Asset[]
  quoteRequests QuoteRequest[]
  modelRequests ModelRequest[]
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(OWNER)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ── Products ─────────────────────────────────────────────────────────────────────────────

enum VersionStatus {
  DRAFT
  PUBLISHED
}

model Product {
  id                 String           @id @default(cuid())
  workspaceId        String
  /// Short, unguessable id used in public URLs (/embed/[publicId]); never the primary key.
  publicId           String           @unique
  name               String
  /// The live version shoppers see. Null until first published.
  publishedVersionId String?          @unique
  archivedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions           ProductVersion[] @relation("ProductVersions")
  publishedVersion   ProductVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  events             Event[]
  quoteRequests      QuoteRequest[]

  @@index([workspaceId, createdAt])
}

/// A product config. Drafts are edited in place; publishing freezes a version for good, so
/// share links and quotes always resolve to exactly what the shopper saw.
model ProductVersion {
  id                   String                @id @default(cuid())
  productId            String
  /// 1, 2, 3… per product.
  number               Int
  status               VersionStatus         @default(DRAFT)
  /// ProductConfig JSON, validated by @twirl/config-schema before every write.
  config               Json
  /// config.schemaVersion, duplicated for migrations without parsing every row.
  schemaVersion        Int
  modelAssetId         String?
  createdById          String?
  publishedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  product              Product               @relation("ProductVersions", fields: [productId], references: [id], onDelete: Cascade)
  publishedFor         Product?              @relation("PublishedVersion")
  modelAsset           Asset?                @relation(fields: [modelAssetId], references: [id], onDelete: Restrict)
  sharedConfigurations SharedConfiguration[]
  quoteRequests        QuoteRequest[]

  @@unique([productId, number])
  @@index([productId, status])
}

enum AssetStatus {
  /// Presigned URL issued; upload not confirmed yet.
  PENDING
  /// Uploaded and passed validation.
  READY
  /// Uploaded but failed validation (see validation report).
  INVALID
}

/// A file in R2 (models now; logos later). Files go browser → R2 directly, never through the app.
model Asset {
  id          String           @id @default(cuid())
  workspaceId String
  /// Object key in the R2 bucket.
  key         String           @unique
  filename    String
  mimeType    String
  /// Bytes.
  size        Int
  status      AssetStatus      @default(PENDING)
  /// Model validation report (meshes, triangles, textures, warnings).
  validation  Json?
  createdAt   DateTime         @default(now())
  uploadedAt  DateTime?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    ProductVersion[]

  @@index([workspaceId, createdAt])
}

// ── Shoppers ─────────────────────────────────────────────────────────────────────────────

/// A shared configuration (/c/[shortId]): selections pinned to a published version.
model SharedConfiguration {
  id         String         @id @default(cuid())
  shortId    String         @unique
  versionId  String
  selections Json
  createdAt  DateTime       @default(now())
  version    ProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

enum QuoteStatus {
  NEW
  READ
  ARCHIVED
}

/// A shopper's quote request. Personal data: only ever read through workspace-scoped queries.
model QuoteRequest {
  id          String         @id @default(cuid())
  workspaceId String
  productId   String
  versionId   String
  name        String
  email       String
  phone       String?
  message     String?
  selections  Json
  /// Re-priced on the server from the version's config; never the client's number.
  priceTotal  Int
  currency    String
  status      QuoteStatus    @default(NEW)
  createdAt   DateTime       @default(now())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  version     ProductVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
}

/// Anonymous usage events (views, option changes, shares…), counted per product.
model Event {
  id        String   @id @default(cuid())
  productId String
  versionId String?
  type      String
  /// Random per-visit id from the browser; not tied to a person.
  sessionId String
  payload   Json?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type, createdAt])
}

// ── Services ─────────────────────────────────────────────────────────────────────────────

enum ModelRequestStatus {
  NEW
  IN_PROGRESS
  DONE
  DECLINED
}

/// A request for our manual 3D-modeling service.
model ModelRequest {
  id          String             @id @default(cuid())
  workspaceId String?
  name        String
  email       String
  company     String?
  description String
  /// Links to product pages, photos or drawings.
  links       String[]
  status      ModelRequestStatus @default(NEW)
  createdAt   DateTime           @default(now())
  workspace   Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
