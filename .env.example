# Twirl environment variables
#
# Copy to apps/web/.env.local for local development. Never commit real values.
# Every variable is validated with Zod in apps/web/src/env/schema.ts; the build
# fails with a list of the offending names if something is missing or invalid.
#
# Variables for later milestones are commented out until the feature that
# needs them lands. Names may still change before then.

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the app, used to build share links and embed snippets.
# Optional until share links and embeds land (M5). Example: https://twirl.example.com
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base URL of the asset bucket (Cloudflare R2), no trailing slash. Serves the 2k HDRIs
# (hdri/2k/) used on large screens for sharper reflections. Optional: without it, 1k HDRIs
# bundled with the app are used everywhere.
# NEXT_PUBLIC_ASSETS_BASE_URL=https://pub-1e330adafeba4efd868fabae2c698a76.r2.dev

# ── Database: Postgres (Neon in production) ──────────────────────────────────
# Pooled connection string for the app. Neon: the "Pooled connection" string.
# Local (docker compose up -d):
# DATABASE_URL=postgresql://twirl:twirl@localhost:5433/twirl
# Direct (non-pooled) connection string, used only for Prisma migrations. Neon: the string
# without "-pooler" in the host. Locally the same as DATABASE_URL (or leave unset).
# DATABASE_URL_UNPOOLED=postgresql://twirl:twirl@localhost:5433/twirl

# ── Auth: Auth.js ────────────────────────────────────────────────────────────
# Sign-in is off locally until AUTH_SECRET and DATABASE_URL are set; on Vercel, the auth and
# email variables below are required (the build fails without them).
# Random secret for signing sessions. Generate with: openssl rand -base64 32
# AUTH_SECRET=
# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID, Web application).
# Redirect URIs: http://localhost:3000/api/auth/callback/google and
# https://<your-domain>/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Comma-separated emails that get admin access.
# ADMIN_EMAILS=you@example.com

# ── Email: Resend ────────────────────────────────────────────────────────────
# API key for magic-link sign-in, quote notifications and admin emails.
# RESEND_API_KEY=
# Sender address. "Twirl <onboarding@resend.dev>" works for testing (it only delivers to your
# Resend account's email); verify your own domain in Resend to email anyone.
# EMAIL_FROM=

# ── Storage: Cloudflare R2 ───────────────────────────────────────────────────
# Uploaded models. Required on Vercel; locally, uploads are off without them.
# Cloudflare dashboard → R2 → Manage API tokens → token with "Object Read & Write" on the bucket.
# The bucket's CORS policy must allow PUT from the app's origins (see docs/adr/0010).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=twirl
# Public base URL that serves the bucket: the r2.dev URL or a custom domain, NOT the
# *.r2.cloudflarestorage.com API endpoint (that one isn't public).
# R2_PUBLIC_URL=https://pub-1e330adafeba4efd868fabae2c698a76.r2.dev

# ── Rate limiting: Upstash Redis ─────────────────────────────────────────────
# Limits on public endpoints (quotes, share links, events). Required on Vercel; locally, rate
# limiting is off without them. Vercel → Storage → Upstash Redis adds these automatically
# (copy the two REST values here to test locally; the other Redis variables aren't used).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
